{
  "name": "live-room-sync",
  "version": "0.4.0",
  "description": "Obsidian plugin: live, serverless vault sync and Google-Docs-style typing with a room code.",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test --test-force-exit --test-timeout=30000 test/sync.test.ts test/party.test.ts test/history.test.ts test/plugin.test.ts",
    "test:smoke": "npm run build && node test/smoke.cjs",
    "test:browser": "node test/browser/build.mjs && node test/browser/run.cjs",
    "css": "python3 tools/build-css.py",
    "preview": "python3 tools/build-css.py && node tools/preview/build.mjs"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@trystero-p2p/core": "^0.26.0",
    "@trystero-p2p/mqtt": "^0.26.0",
    "@trystero-p2p/nostr": "^0.26.0",
    "@trystero-p2p/torrent": "^0.26.0",
    "diff-match-patch": "^1.0.5",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "obsidian": "^1.14.4",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
